      "Getting Top Companies :Aerospace & Defense Companies\n",
      "Getting Top Companies :Capital Markets Companies\n",
      "Getting Top Companies :Computers - Software & Consulting Companies\n",
      "Getting Top Companies :Hospital Companies\n",
      "Getting Top Companies :IT Enabled Services Companies\n",
      "Getting Top Companies :Non Banking Financial Company (NBFC) Companies\n",
      "Getting Top Companies :Other Bank Companies\n",
      "Getting Top Companies :Public Sector Bank Companies\n",
      "Getting Top Companies :Specialty Chemicals Companies\n",
      "Getting Top Companies :Stockbroking & Allied Companies\n"
     ]
    }
   ],
   "source": [
    "import os\n",
    "import glob\n",
    "import pandas as pd\n",
    "import math\n",
    "root_dir = r\"D:\stocks\Apps_link\Sector\"  # replace with your path\n",
    "# Empty list to hold dataframes\n",
    "df_list = []\n",
    "\n",
    "for item in os.listdir(root_dir):\n",
    "    full_path = os.path.join(root_dir, item)\n",
    "    if os.path.isdir(full_path):\n",
    "        #print(f\"Top-level Folder: {full_path}\")\n",
    "        for file in glob.glob(full_path + \"/*.csv*\"):  # all files\n",
    "            print(f\"Getting Top Companies :{item}\")\n",
    "            df = pd.read_csv(file)#Read each cvs files from sector folder\n",
    "            df_sorted = df.sort_values(by=\"score\", ascending=False)  # ascending=False for descending\n",
    "            max_score=math.floor(df['score'][0] / 10) * 10\n",
    "            df=df_sorted[df_sorted['score']>=max_score]\n",
    "            df_list.append(df)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "61001cc7-b2bc-4d44-8a78-1daf120ff86d",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Combine all into one final dataframe\n",
    "final_df = pd.concat(df_list, ignore_index=True)\n",
    "base_path=r\"D:\stocks\Apps_link\Sector\"\n",
    "folder_path = os.path.join(base_path, \"Sector_Combined.csv\")\n",
    "final_df.to_csv(folder_path, index=False, encoding=\"utf-8-sig\")"
   ]
  },
