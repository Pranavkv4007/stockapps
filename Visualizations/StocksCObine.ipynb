    "import json\n",
    "import pandas as pd\n",
    "from openpyxl import Workbook\n",
    "from openpyxl.styles import Font, PatternFill, Alignment\n",
    "from openpyxl.utils import get_column_letter\n",
    "\n",
    "# Read JSON file\n",
    "json_filename = r'D:\stocks\Apps_link\\scores.json'  # Change this to your file path if needed\n",
    "\n",
    "try:\n",
    "    with open(json_filename, 'r', encoding='utf-8') as f:\n",
    "        data = json.load(f)\n",
    "    print(f\"✓ Successfully loaded '{json_filename}'\")\n",
    "except FileNotFoundError:\n",
    "    print(f\"✗ Error: File '{json_filename}' not found!\")\n",
    "    exit(1)\n",
    "except json.JSONDecodeError as e:\n",
    "    print(f\"✗ Error: Invalid JSON format - {e}\")\n",
    "    exit(1)\n",
    "\n",
    "# Process credibility scores to remove the extension\n",
    "credibility_cleaned = {}\n",
    "for key, value in data['credibility_scores'].items():\n",
    "    # Remove '_concall_score.txt' extension\n",
    "    clean_name = key.replace('_concall_score.txt', '')\n",
    "    credibility_cleaned[clean_name] = value\n",
    "\n",
    "# Get all unique company names\n",
    "all_companies = set(data['overall_scores'].keys()) | set(credibility_cleaned.keys())\n",
    "\n",
    "# Create a list of dictionaries for the DataFrame\n",
    "records = []\n",
    "for company in sorted(all_companies):\n",
    "    overall = data['overall_scores'].get(company, 'NA')\n",
    "    credibility = credibility_cleaned.get(company, 'NA')\n",
    "    records.append({\n",
    "        'Company Name': company,\n",
    "        'Overall Score': overall,\n",
    "        'Credibility Score': credibility\n",
    "    })\n",
    "\n",
    "# Create DataFrame\n",
    "df = pd.DataFrame(records)\n",
    "\n",
    "# Save to Excel with formatting\n",
    "excel_filename = 'company_scores_mapping.xlsx'\n",
    "with pd.ExcelWriter(excel_filename, engine='openpyxl') as writer:\n",
    "    df.to_excel(writer, sheet_name='Company Scores', index=False)\n",
    "    \n",
    "    # Get the workbook and worksheet\n",
    "    workbook = writer.book\n",
    "    worksheet = writer.sheets['Company Scores']\n",
    "    \n",
    "    # Format header row\n",
    "    header_fill = PatternFill(start_color='366092', end_color='366092', fill_type='solid')\n",
    "    header_font = Font(bold=True, color='FFFFFF')\n",
    "    \n",
    "    for cell in worksheet[1]:\n",
    "        cell.fill = header_fill\n",
    "        cell.font = header_font\n",
    "        cell.alignment = Alignment(horizontal='center', vertical='center')\n",
    "    \n",
    "    # Adjust column widths\n",
    "    worksheet.column_dimensions['A'].width = 50\n",
    "    worksheet.column_dimensions['B'].width = 15\n",
    "    worksheet.column_dimensions['C'].width = 18\n",
    "    \n",
    "    # Center align score columns\n",
    "    for row in worksheet.iter_rows(min_row=2, min_col=2, max_col=3):\n",
    "        for cell in row:\n",
    "            cell.alignment = Alignment(horizontal='center', vertical='center')\n",
    "    \n",
    "    # Add color scaling for Overall Score column (Column B)\n",
    "    from openpyxl.formatting.rule import ColorScaleRule\n",
    "    \n",
    "    overall_score_rule = ColorScaleRule(\n",
    "        start_type='min', start_color='F8696B',  # Red for low scores\n",
    "        mid_type='percentile', mid_value=50, mid_color='FFEB84',  # Yellow for medium\n",
    "        end_type='max', end_color='63BE7B'  # Green for high scores\n",
    "    )\n",
    "    \n",
    "    # Apply to Overall Score column (skip header, only data rows)\n",
    "    worksheet.conditional_formatting.add(\n",
    "        f'B2:B{len(records) + 1}',\n",
    "        overall_score_rule\n",
    "    )\n",
    "    \n",
    "    # Add color scaling for Credibility Score column (Column C)\n",
    "    credibility_score_rule = ColorScaleRule(\n",
    "        start_type='min', start_color='F8696B',  # Red for low scores\n",
    "        mid_type='percentile', mid_value=50, mid_color='FFEB84',  # Yellow for medium\n",
    "        end_type='max', end_color='63BE7B'  # Green for high scores\n",
    "    )\n",
    "    \n",
    "    # Apply to Credibility Score column (skip header, only data rows)\n",
    "    worksheet.conditional_formatting.add(\n",
    "        f'C2:C{len(records) + 1}',\n",
    "        credibility_score_rule\n",
    "    )\n",
    "\n",
    "print(f\"✓ Excel file '{excel_filename}' created successfully!\")\n",
    "print(f\"✓ Total companies processed: {len(records)}\")\n",
    "print(f\"✓ Companies with overall scores: {sum(1 for r in records if r['Overall Score'] != 'NA')}\")\n",
    "print(f\"✓ Companies with credibility scores: {sum(1 for r in records if r['Credibility Score'] != 'NA')}\")\n",
    "print(f\"✓ Companies with both scores: {sum(1 for r in records if r['Overall Score'] != 'NA' and r['Credibility Score'] != 'NA')}\")\n",
    "\n",
    "# Show some details\n",
    "print(\"\\n--- Sample Mappings ---\")\n",
    "for i, record in enumerate(records[:5]):\n",
    "    print(f\"{record['Company Name']}: Overall={record['Overall Score']}, Credibility={record['Credibility Score']}\")\n",
    "print(\"...\")"
   ]
