    "import os\n",
    "import re\n",
    "import json\n",
    "\n",
    "def extract_score(file_path):\n",
    "    \"\"\"\n",
    "    Extract score from file content.\n",
    "    Looks for lines containing \"Overall Score\" and extracts the numeric score.\n",
    "    Examples: \"## Overall Score: 78/100\" or \"Overall Score: 73/100\"\n",
    "    Returns the numeric score (e.g., 78)\n",
    "    \"\"\"\n",
    "    try:\n",
    "        with open(file_path, 'r', encoding='utf-8') as f:\n",
    "            for line in f:\n",
    "                # Check if line contains \"Overall Score\" (case insensitive)\n",
    "                if 'overall score' in line.lower():\n",
    "                    # Extract the numeric score before /100\n",
    "                    pattern = r'(\\d+)\\s*/\\s*100'\n",
    "                    match = re.search(pattern, line)\n",
    "                    \n",
    "                    if match:\n",
    "                        return int(match.group(1))\n",
    "            \n",
    "        return None\n",
    "        \n",
    "    except Exception as e:\n",
    "        print(f\"Error reading {file_path}: {e}\")\n",
    "        return None\n",
    "\n",
    "def extract_credibility_score(file_path):\n",
    "    \"\"\"\n",
    "    Extract Final Credibility Score from file content.\n",
    "    Looks for lines containing \"Final Credibility Score\" or \"Overall Credibility Score\" \n",
    "    and extracts the numeric score.\n",
    "    \n",
    "    Handles multiple formats:\n",
    "    - \"Final Credibility Score: 42.33 (Weak Credibility)\"\n",
    "    - \"Overall Credibility Score | 68 (Moderate to Strong Credibility)\"\n",
    "    - \"Final Credibility Score:** 🟡 **53 / 100\"\n",
    "    - \"Final Credibility Score: 94.4 / 100\"\n",
    "    - \"Overall Score | **42/100 (Weak credibility, improving)**\"\n",
    "    \n",
    "    Returns the numeric score (e.g., 42.33, 68, 53, 94.4, 42)\n",
    "    \"\"\"\n",
    "    try:\n",
    "        with open(file_path, 'r', encoding='utf-8') as f:\n",
    "            content = f.read()\n",
    "            \n",
    "            # Try multiple patterns in order of specificity\n",
    "            patterns_to_try = [\n",
    "                # Pattern 1: \"credibility score\" followed by number/100 or number/100\n",
    "                (r'credibility score[:\\s*|]+\\*{0,2}\\s*(?:🟡|🟢|🔴)?\\s*\\*{0,2}\\s*(\\d+(?:\\.\\d+)?)\\s*/\\s*100', 'credibility score'),\n",
    "                \n",
    "                # Pattern 2: \"credibility score\" followed by just a number (with optional parentheses after)\n",
    "                (r'credibility score[:\\s*|]+\\*{0,2}\\s*(?:🟡|🟢|🔴)?\\s*\\*{0,2}\\s*(\\d+(?:\\.\\d+)?)\\s*(?:\\(|$|\\s)', 'credibility score'),\n",
    "                \n",
    "                # Pattern 3: For table format with pipes, capture number before parentheses or pipes\n",
    "                (r'\\|\\s*\\*{0,2}\\s*(\\d+(?:\\.\\d+)?)\\s*(?:\\(|\\|)', 'table format')\n",
    "            ]\n",
    "            \n",
    "            # Search for \"credibility score\" in the content (case insensitive)\n",
    "            for pattern, pattern_name in patterns_to_try:\n",
    "                matches = re.finditer(pattern, content, re.IGNORECASE)\n",
    "                \n",
    "                for match in matches:\n",
    "                    score = float(match.group(1))\n",
    "                    # Sanity check: score should be between 0 and 100\n",
    "                    if 0 <= score <= 100:\n",
    "                        print(f\"  -> Found score {score} using pattern: {pattern_name}\")\n",
    "                        return score\n",
    "            \n",
    "            return None\n",
    "            \n",
    "    except Exception as e:\n",
    "        print(f\"Error reading {file_path}: {e}\")\n",
    "        return None\n",
    "\n",
    "def process_overall_score_files():\n",
    "    \"\"\"\n",
    "    Process all .txt files that don't have underscore before extension.\n",
    "    Extracts \"Overall Score\" from these files.\n",
    "    Returns a dictionary with filename (without .txt) as key and score as value.\n",
    "    \"\"\"\n",
    "    results = {}\n",
    "    directory = r\"D:\stocks\Apps_link\\Individual_Stocks\"\n",
    "    \n",
    "    # Get all files in directory\n",
    "    for filename in os.listdir(directory):\n",
    "        # Check if file is .txt and doesn't match pattern *_*.txt\n",
    "        if filename.endswith('.txt') and '_' not in filename.replace('.txt', ''):\n",
    "            file_path = os.path.join(directory, filename)\n",
    "            \n",
    "            # Extract score\n",
    "            score = extract_score(file_path)\n",
    "            \n",
    "            if score is not None:\n",
    "                # Use filename without extension as key\n",
    "                company_name = filename.replace('.txt', '')\n",
    "                results[company_name] = score\n",
    "                print(f\"Processed: {filename} -> Overall Score: {score}\")\n",
    "            else:\n",
    "                print(f\"No overall score found in: {filename}\")\n",
    "    \n",
    "    return results\n",
    "\n",
    "def process_credibility_score_files():\n",
    "    \"\"\"\n",
    "    Process all *__concall_score.txt files.\n",
    "    Extracts \"Final Credibility Score\" or \"Overall Credibility Score\" from these files.\n",
    "    Returns a dictionary with company name as key and score as value.\n",
    "    \"\"\"\n",
    "    results = {}\n",
    "    directory = r\"D:\stocks\Apps_link\Individual_Stocks\"\n",
    "    \n",
    "    # Get all files in directory\n",
    "    for filename in os.listdir(directory):\n",
    "        # Check if file matches pattern *__concall_score.txt\n",
    "        if filename.endswith('_concall_score.txt'):\n",
    "            file_path = os.path.join(directory, filename)\n",
    "            \n",
    "            # Extract score\n",
    "            score = extract_credibility_score(file_path)\n",
    "            \n",
    "            if score is not None:\n",
    "                # Extract company name (remove __concall_score.txt suffix)\n",
    "                company_name = filename.replace('_concall_score.txt', '')\n",
    "                results[company_name] = score\n",
    "                print(f\"Processed: {filename} -> Credibility Score: {score}\")\n",
    "            else:\n",
    "                print(f\"No credibility score found in: {filename}\")\n",
    "    \n",
    "    return results\n",
    "\n",
    "def main():\n",
    "    print(\"=\" * 50)\n",
    "    print(\"Processing Overall Scores (*.txt files)\")\n",
    "    print(\"=\" * 50)\n",
    "    overall_scores = process_overall_score_files()\n",
    "    \n",
    "    print(\"\\n\" + \"=\" * 50)\n",
    "    print(\"Processing Credibility Scores (*__concall_score.txt files)\")\n",
    "    print(\"=\" * 50)\n",
    "    credibility_scores = process_credibility_score_files()\n",
    "    \n",
    "    # Create combined results\n",
    "    results = {\n",
    "        \"overall_scores\": overall_scores,\n",
    "        \"credibility_scores\": credibility_scores\n",
    "    }\n",
    "    \n",
    "    # Create JSON output\n",
    "    output_file = 'scores.json'\n",
    "    with open(output_file, 'w', encoding='utf-8') as f:\n",
    "        json.dump(results, f, indent=2)\n",
    "    \n",
    "    print(\"\\n\" + \"=\" * 50)\n",
    "    print(f\"Results saved to {output_file}\")\n",
    "    print(f\"Overall scores found: {len(overall_scores)}\")\n",
    "    print(f\"Credibility scores found: {len(credibility_scores)}\")\n",
    "    print(\"\\nFinal Results:\")\n",
    "    print(json.dumps(results, indent=2))\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    main()"
   ]
  },
